{
  "name": "@discord3/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.tsx --bundle --format=esm --jsx=automatic --platform=browser --outfile=dist/index.js --external:@discord3/shared --external:@discord3/webrtc --external:react --external:react-dom --external:zustand",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@discord3/shared": "*",
    "@discord3/webrtc": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
