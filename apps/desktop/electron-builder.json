{
  "appId": "com.freehub.app",
  "productName": "Freehub",
  "electronVersion": "33.4.11",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "package.json"],
  "asar": true,
  "asarUnpack": ["node_modules/sql.js/**/*"],
  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Brakister",
        "repo": "freehub"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.social-networking",
    "publish": [
      {
        "provider": "github",
        "owner": "Brakister",
        "repo": "freehub"
      }
    ]
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Network"
  }
}
