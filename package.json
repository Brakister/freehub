{
  "name": "freehub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:server": "tsx scripts/test-server.ts",
    "tunnel:server": "powershell -ExecutionPolicy Bypass -File scripts/tunnel.ps1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
